{% extends 'base.html.twig' %}

{% block title %}Richiesta prenotazione{% endblock %}

{% block body %}
	<section class="page-hero">
		<div class="page-hero__content">
			<span class="page-hero__eyebrow">CV Prenotazioni</span>
			<h1 class="page-hero__title">Richiesta prenotazione</h1>
			<p class="page-hero__subtitle">
				Compila i dettagli principali e invia la richiesta: ti risponderemo con la disponibilita e i prossimi passi.
			</p>
		</div>
	</section>

	<div class="booking-shell">
		<div class="booking-card">
			{{ form_start(form) }}
			<div class="row">
				<div class="col-8 mt-2">
					{{ form_label(form.fkPorteur) }}
					{{ form_widget(form.fkPorteur) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.fkPorteur) }}
					</div>
				</div>
				<div class="col-4 mt-2">
					{{ form_label(form.Pin) }}
					{{ form_widget(form.Pin) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.Pin) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-12 mt-2">
					{{ form_label(form.Cliente) }}
					{{ form_widget(form.Cliente) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.Cliente) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-6 mt-2">
					{{ form_label(form.Dal) }}
					{{ form_widget(form.Dal, {'value' : 'now'|date('Y-m-d', "Europe/Rome")}) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.Dal) }}
					</div>
				</div>
				<div class="col-md-6 mt-2">
					{{ form_label(form.Al) }}
					{{ form_widget(form.Al, {'value' : 'now'|date('Y-m-d', "Europe/Rome")}) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.Al) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-4 mt-2">
					{{ form_label(form.PaxAdulti) }}
					{{ form_widget(form.PaxAdulti) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.PaxAdulti) }}
					</div>
				</div>
				<div class="col-md-4 mt-2">
					{{ form_label(form.PaxBambini) }}
					{{ form_widget(form.PaxBambini) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.PaxBambini) }}
					</div>
				</div>
				<div class="col-md-4 mt-2">
					{{ form_label(form.PaxAdolescenti) }}
					{{ form_widget(form.PaxAdolescenti) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.PaxAdolescenti) }}
					</div>
				</div>
			</div>

			<div class="section-divider"></div>

			<div class="row">
				<div class="col-md-12 mt-2">
					{{ form_label(form.fkTipologiaOspitalita) }}
					{{ form_widget(form.fkTipologiaOspitalita) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.fkTipologiaOspitalita) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-12 mt-2">
					{{ form_label(form.fkAlbergo) }}
					{{ form_widget(form.fkAlbergo) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.fkAlbergo) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-12 mt-2">
					{{ form_label(form.fkTipologiaSistemazione) }}
					{{ form_widget(form.fkTipologiaSistemazione) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.fkTipologiaSistemazione) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-12 mt-2">
					{{ form_label(form.fkTariffa) }}
					{{ form_widget(form.fkTariffa) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.fkTariffa) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-12 mt-2">
					{{ form_label(form.Note) }}
					{{ form_widget(form.Note) }}
					<div class="text-red li-senza-pallino">
						{{ form_errors(form.Note) }}
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-12 mt-4 mb-2">
					<button type="submit" class="btn btn-cta w-100">INVIA</button>
				</div>
			</div>
			{{ form_end(form) }}
		</div>

		<aside class="booking-meta">
			<div class="booking-meta__title">Promemoria rapido</div>
			<div class="booking-meta__list">
				<div class="booking-meta__pill">Conferma in 24/48h</div>
				<div>Inserisci le date complete per verificare la disponibilita.</div>
				<div>Specifica note speciali per richieste personalizzate.</div>
				<div>Riceverai un riepilogo prima della conferma.</div>
			</div>
		</aside>
	</div>

{% endblock %}
