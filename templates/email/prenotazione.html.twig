<h2>Nuova prenotazione</h2>

<ul>
  <li><b>Cliente:</b> {{ p.cliente }}</li>
  <li><b>Dal:</b> {{ p.dal|date('d/m/Y') }} <b>al:</b> {{ p.al|date('d/m/Y') }}</li>
  <li><b>Pax:</b>
    Adulti {{ p.paxAdulti }},
    Bambini {{ p.paxBambini }},
    Adolescenti {{ p.paxAdolescenti }}
  </li>
  <li><b>Albergo:</b> {{ p.fkAlbergo.descrizione }}</li>
  <li><b>Sistemazione:</b> {{ p.fkTipologiaSistemazione.descrizione }}</li>
  <li><b>Ospitalità:</b> {{ p.fkTipologiaOspitalita.descrizione }}</li>
  <li><b>Tariffa:</b> {{ p.fkTariffa.descrizione }}</li>
  <li><b>Porteur:</b> {{ p.fkPorteur.descrizione }}</li>
</ul>

{% if p.note %}
  <h3>Note</h3>
  <p>{{ p.note|nl2br }}</p>
{% endif %}